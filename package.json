{
  "name": "cursor-rpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "description": "Unofficial research bridge for experimenting with Cursor's ConnectRPC protocol against a self-hosted OpenAI-compatible model.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velum-labs/cursorkit.git"
  },
  "main": "./dist/src/cli.js",
  "types": "./dist/src/cli.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "modelFusionProtocol": {
    "packageName": "@velum/model-fusion-protocol",
    "version": "0.1.0",
    "schemaBundleHash": "sha256:75792f89c091b6ab4fd317a15fb03fd73438563dceff5ccf9f5d7c752dbf35f3",
    "contracts": "json-schema+openapi-3.1",
    "origin": "fusionkit"
  },
  "exports": {
    ".": "./dist/src/cli.js",
    "./extensions": {
      "types": "./dist/src/extensions/index.d.ts",
      "import": "./dist/src/extensions/index.js"
    },
    "./providers/openai": {
      "types": "./dist/src/providers/openai.d.ts",
      "import": "./dist/src/providers/openai.js"
    },
    "./model-fusion": {
      "types": "./dist/src/modelFusion/index.d.ts",
      "import": "./dist/src/modelFusion/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "codegen": "buf generate proto && tsx src/tools/normalizeGeneratedCode.ts",
    "extract:protos": "cd vendor/extract-cursor-protos && go run . /Applications/Cursor.app ../../proto",
    "proto:inventory": "tsx src/tools/generateProtoInventory.ts",
    "baseline:generate": "tsx src/tools/baselineInventory.ts",
    "baseline:check": "tsx src/tools/baselineInventory.ts --check",
    "test": "vitest run tests",
    "e2e:cursor-agent": "python3 tests/e2e/cursor-agent-smoke.py",
    "model-fusion:openapi:generate": "openapi-typescript docs/model-fusion-cursor-harness.openapi.yaml -o src/gen/model_fusion/cursor_harness_openapi.ts",
    "model-fusion:openapi:check": "pnpm model-fusion:openapi:generate && prettier --write src/gen/model_fusion/cursor_harness_openapi.ts && git diff --exit-code -- src/gen/model_fusion/cursor_harness_openapi.ts",
    "model-fusion:protocol:check": "tsx src/tools/checkModelFusionProtocol.ts",
    "release:publish:check": "tsx src/tools/checkReleasePublishConfig.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.yaml\" \"examples/**/*.ts\" \".github/workflows/*.yml\"",
    "examples:check": "tsc -p tsconfig.examples.json --noEmit",
    "check": "pnpm build && pnpm test && pnpm model-fusion:openapi:check && pnpm model-fusion:protocol:check && pnpm release:publish:check && pnpm format:check",
    "release:check": "tsx src/tools/releaseCheck.ts",
    "serve": "node dist/src/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "ck": "node dist/src/ck.js",
    "test:harness": "node dist/src/testing/cli.js"
  },
  "bin": {
    "ck": "./dist/src/ck.js",
    "cursor-rpc": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "proto",
    "docs",
    "README.md",
    "DISCLAIMER.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "protobufjs": "8.6.3",
    "selfsigned": "5.5.0",
    "undici": "8.4.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@types/node": "24.10.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.8.4",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
